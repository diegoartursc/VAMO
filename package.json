{
  "name": "vamo-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run dev --workspace=apps/mobile",
    "dev:site": "npm run dev --workspace=apps/site",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "build:mobile": "npm run build:web --workspace=apps/mobile",
    "build:site": "npm run build --workspace=apps/site"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3"
  }
}
