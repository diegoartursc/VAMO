generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "darwin-arm64", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum EmployeeRole {
  MANAGER
  ATTENDANT
}

enum AgencyPlan {
  FREE
}

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
  FACEBOOK
}

enum VerificationLevel {
  BASIC
  TRUSTED
  EXPERT
  AMBASSADOR
}

enum PackageBadge {
  BESTSELLER
  FLASH
  LUXURY
  VALUE
  VERIFIED
  NEW
  FEATURED
}

enum PackageStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ItineraryStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PurchaseStatus {
  AWAITING_QUOTE
  PROCESSING
  DOCS_SENT
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum NotificationType {
  PRICE_ALERT
  PURCHASE_UPDATE
  PROMO
  SYSTEM
}

enum BookingTimelineStatus {
  COMPLETED
  IN_PROGRESS
  PENDING
}

enum BookingDocumentType {
  VOUCHER
  TICKET
  POLICY
  INFO
}

enum DepartureStatus {
  ABERTA
  QUASE_LOTADO
  ESGOTADO
  ENCERRADA
}

enum QuoteStatus {
  AWAITING_QUOTE
  QUOTED
  ACCEPTED
  EXPIRED
  REJECTED
}

enum AgencyDocType {
  BOARDING_PASS
  HOTEL_VOUCHER
  HOTEL_CHECKIN
  TRANSFER_VOUCHER
  TOUR_TICKET
  INSURANCE
  OTHER
}

// ─────────────────────────────────────────────
// ADMIN
// ─────────────────────────────────────────────

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(MODERATOR)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admins")
}

// ─────────────────────────────────────────────
// AGENCY
// ─────────────────────────────────────────────

model Agency {
  id              String     @id @default(cuid())
  name            String
  // CNPJ opcional: mercado australiano (AUD) não usa identificação fiscal BR.
  // Múltiplos NULL são permitidos sob índice @unique no Postgres.
  cnpj            String?    @unique
  logo            String?
  contactUrl      String?
  whatsapp        String?
  address         String?
  city            String?
  state           String?
  zipCode         String?
  plan            AgencyPlan @default(FREE)
  verified        Boolean    @default(false)
  verificationDoc String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  employees       AgencyEmployee[]
  packages        Package[]
  reviewResponses ReviewResponse[]

  @@map("agencies")
}

model AgencyEmployee {
  id           String       @id @default(cuid())
  agencyId     String
  name         String
  email        String       @unique
  passwordHash String
  role         EmployeeRole @default(ATTENDANT)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  agency     Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  faqAnswers FaqAnswer[]

  @@map("agency_employees")
}

// ─────────────────────────────────────────────
// TRAVELER
// ─────────────────────────────────────────────

model Traveler {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  passwordHash   String?
  avatar         String?
  coverUrl       String?
  authProvider   AuthProvider @default(EMAIL)
  authProviderId String?
  bio            String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  personalData        TravelerPersonalData?
  creator             Creator?
  reviews             Review[]
  purchases           PurchaseHistory[]
  itinerarySales      ItinerarySale[]
  savedItems          SavedItem[]
  notifications       Notification[]
  faqQuestions        FaqQuestion[]
  checklistItems      TravelerChecklistItem[]
  tripFiles           TravelerFile[]
  routeCustomizations TravelerItineraryCustomization[]

  @@map("travelers")
}

model TravelerPersonalData {
  id             String    @id @default(cuid())
  travelerId     String    @unique
  cpf            String?
  phone          String?
  birthDate      DateTime?
  passportNumber String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  traveler Traveler @relation(fields: [travelerId], references: [id], onDelete: Cascade)

  @@map("traveler_personal_data")
}

// ─────────────────────────────────────────────
// CREATOR (roteirista)
// ─────────────────────────────────────────────

model Creator {
  id                String            @id @default(cuid())
  travelerId        String            @unique
  verificationLevel VerificationLevel @default(BASIC)
  bio               String            @db.Text
  destinations      String[]
  languages         String[]
  memberSince       DateTime          @default(now())
  instagramUrl      String?
  youtubeUrl        String?
  blogUrl           String?
  // Cached stats for fast display
  totalSales        Int               @default(0)
  averageRating     Float?
  responseTime      String?
  tripsCompleted    Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  traveler        Traveler         @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  balance         CreatorBalance?
  itineraries     Itinerary[]
  reviewResponses ReviewResponse[]

  @@map("creators")
}

model CreatorBalance {
  id               String   @id @default(cuid())
  creatorId        String   @unique
  availableBalance Float    @default(0)
  pendingBalance   Float    @default(0)
  currency         String   @default("AUD")
  updatedAt        DateTime @updatedAt

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("creator_balances")
}

// ─────────────────────────────────────────────
// PACKAGE
// ─────────────────────────────────────────────

model Package {
  id                  String        @id @default(cuid())
  agencyId            String
  title               String
  destination         String
  country             String
  description         String        @db.Text
  fullDescription     String?       @db.Text
  emotionalIntro      String?       @db.Text
  currency            String        @default("AUD")
  duration            Int
  maxSlots            Int?
  // Price range (derived from pricing windows or set manually)
  priceMin            Float?
  priceMax            Float?
  // Array fields
  includes            String[]
  includedItems       String[]
  highlights          String[]
  notRecommendedFor   String[]
  importantInfo       String[]
  perfectFor          String[]
  categories          String[]
  // Registration system — Block 1 (Destination)
  continent           String? // auto-calculated from country
  airport             String? // main airport code (e.g. CDG, GRU)
  multiDestination    Boolean       @default(false)
  additionalCities    String[]
  // Registration system — Block 2 (Duration)
  nights              Int? // auto: duration - 1
  // Registration system — Block 3 (Travel Style)
  travelStyles        String[] // max 3: Luxo, Econômico, Mochilão, Família, Romântico, Aventura
  // Structured JSON fields
  inclusions          Json? // { flight, hotel: { stars, meals }, tours, extras }
  routeDetails        Json? // { mainStop, pickupLocations, transport, mainActivity, returnLocations, mapImageUrl }
  // Registration system — Block 5 (Price extras)
  promoPrice          Float? // promotional price
  installments        Int? // max installments (e.g. 12x)
  cancellationPolicy  String?       @db.Text
  // Registration system — Block 7 (Post-purchase docs)
  whatsappOfficial    String?
  autoMessage         String?       @db.Text
  voucherUrl          String?
  eticketUrl          String?
  // Quality & trust
  qualityScore        Int? // 0-100 calculated
  badge               PackageBadge?
  rating              Float?
  reviewCount         Int           @default(0)
  featured            Boolean       @default(false)
  hasFreeCancellation Boolean       @default(false)
  isAllInclusive      Boolean       @default(false)
  recentPurchases     Int           @default(0)
  priceComparison     String? // 'below' | 'average' | 'above'
  priceDiscount       Int           @default(0)
  status              PackageStatus @default(DRAFT)
  approvalNote        String?       @db.Text
  approvedAt          DateTime?
  approvedBy          String? // admin id
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  agency         Agency                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  images         PackageImage[]
  pricingWindows PackagePricingWindow[]
  departures     PackageDeparture[]
  reviews        Review[]
  purchases      PurchaseHistory[]
  savedItems     SavedItem[]
  faqQuestions   FaqQuestion[]

  @@map("packages")
}

model PackageImage {
  id        String   @id @default(cuid())
  packageId String
  url       String
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_images")
}

model PackagePricingWindow {
  id             String   @id @default(cuid())
  packageId      String
  startDate      DateTime
  endDate        DateTime
  price          Float
  availableSlots Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  package   Package           @relation(fields: [packageId], references: [id], onDelete: Cascade)
  purchases PurchaseHistory[]

  @@map("package_pricing_windows")
}

model PackageDeparture {
  id                    String          @id @default(cuid())
  packageId             String
  startDate             DateTime
  price                 Float
  capacityTotal         Int // total group capacity
  capacityVamo          Int // slots allocated to VAMO
  capacityVamoAvailable Int // remaining VAMO slots
  minPeople             Int? // minimum to confirm departure
  status                DepartureStatus @default(ABERTA)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  package  Package           @relation(fields: [packageId], references: [id], onDelete: Cascade)
  bookings PurchaseHistory[] @relation("DepartureBookings")

  @@map("package_departures")
}

// ─────────────────────────────────────────────
// ITINERARY (roteiro interativo)
// ─────────────────────────────────────────────

model Itinerary {
  id                 String          @id @default(cuid())
  creatorId          String
  title              String
  destination        String
  country            String
  description        String          @db.Text
  price              Float
  currency           String          @default("AUD")
  duration           Int
  rating             Float?
  reviewCount        Int             @default(0)
  downloadCount      Int             @default(0)
  featured           Boolean         @default(false)
  // Array fields
  highlights         String[]
  inclusions         String[] // e.g. ["Planilha", "Mapa", "Guia de Frases"]
  // Structured spending estimate
  estimatedSpending  Json? // { min, max, currency, breakdown: [{ category, amount, description }] }
  // ─── Bloco 1: Identidade ───
  subtitle           String?         @db.VarChar(160)
  travelStyles       String[] // max 3
  categories         String[] // min 1, max 5
  productType        String          @default("DIGITAL") // DIGITAL | PRESENCIAL | HIBRIDO
  // ─── Bloco 3: Módulos ativos ───
  activeModules      String[] // itinerario, mapa, hospedagem, transporte, gasto, restaurantes, dicas, checklist, voo
  // ─── Bloco 2: Estrutura Comercial ───
  promoPrice         Float?
  installments       Int?
  immediateAccess    Boolean         @default(true)
  lifetimeAccess     Boolean         @default(true)
  offlineDownload    Boolean         @default(true)
  // ─── Bloco 7: Configuração Pós-compra ───
  allowPdf           Boolean         @default(false)
  allowShare         Boolean         @default(true)
  // ─── Comprovante de viagem ───
  travelProofUrl     String?         @db.Text // URL do documento enviado pelo criador
  // ─── Destinos adicionais (multi-destino) ───
  extraCities        String[]
  extraCountries     String[]
  // ─── Módulos como JSON (estrutura semi-livre) ───
  flightInfo         Json? // { outbound, return, totalPrice, priceCurrency, tips: [], spending, cost }
  attractions        Json? // [{ name, type, location, mapLink, description, hours, duration, externalLink, tips, startDate, endDate, ticketValue, ticketCurrency, spending?, cost? }]
  restaurants        Json? // [{ name, cuisine, location, description, hours, hoursStart, externalLink, tips, startDate, endDate, priceValue, priceCurrency, spending?, cost? }]
  // ─── Gastos Extras (módulo "Gastos Extras" — transparência graduada) ───
  // [{ id, category, title, description, value, currency, cost?: ModuleCostInfo }]
  // Persiste em JSON porque a estrutura é livre e gerenciada inteiramente
  // pelo cliente (mobile). Mantém retrocompatibilidade automática com
  // roteiros antigos (default null).
  extraSpendingItems Json?
  generalTips        String[]
  mediaUrls          String[] // Fotos/vídeos extras
  highlightPhotos    String[] // 3 fotos de destaque do criador
  // Enquadramento da capa: { x: 0..1, y: 0..1 } — 0.5/0.5 = centro.
  // Permite ao criador ajustar qual parte da capa aparece no card/hero
  // sem precisar recortar a imagem. Aplicado via objectPosition (web) e
  // (futuro) transform translation (native). Default null = centralizado.
  coverFocalPoint    Json?
  // ─── Datas da viagem (para exibição pós-compra) ───
  tripStartDate      DateTime?
  tripEndDate        DateTime?
  // ─── Perfil de gasto (para pós-compra) ───
  spendingProfile    Json? // { icon, label }
  receiveList        Json? // [{ icon, label }]
  // ─── Quality ───
  qualityScore       Int             @default(0)
  status             ItineraryStatus @default(DRAFT)
  approvalNote       String?         @db.Text
  approvedAt         DateTime?
  approvedBy         String? // admin id
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  creator                Creator                          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  images                 ItineraryImage[]
  days                   ItineraryDay[]
  files                  ItineraryFile[]
  reviews                Review[]
  sales                  ItinerarySale[]
  savedItems             SavedItem[]
  faqQuestions           FaqQuestion[]
  accommodations         ItineraryAccommodation[]
  transports             ItineraryTransport[]
  checklists             ItineraryChecklist[]
  travelerChecklistItems TravelerChecklistItem[]
  travelerFiles          TravelerFile[]
  travelerCustomizations TravelerItineraryCustomization[]
  shares                 ItineraryShare[]

  @@map("itineraries")
}

// ─────────────────────────────────────────────
// ITINERARY SHARE (eventos de compartilhamento + rastreio de cliques)
// ─────────────────────────────────────────────
// Cada registro = uma intenção/conclusão de compartilhamento de um roteiro
// (botão "Compartilhar" no app). Usado para gamificação (sharedCount) e para
// medir viralidade real via shareCode (link rastreável).
//
// IMPORTANTE: nunca persistir conteúdo personalizado do comprador aqui — o
// link sempre aponta para a página pública do roteiro original.
model ItineraryShare {
  id           String    @id @default(cuid())
  itineraryId  String
  travelerId   String?
  // Vínculo opcional com Creator se o ator é dono do roteiro (analytics).
  creatorId    String?
  // Vínculo opcional com a venda quando o share veio da tela pós-compra.
  saleId       String?
  // 'traveler' | 'creator' (ator no momento do share)
  actorRole    String
  // 'detail' | 'card' | 'purchased_itinerary' | 'creator_dashboard'
  surface      String
  // 'native_share' | 'copy_link' | 'whatsapp' | 'telegram' | 'email' | 'unknown'
  channel      String
  // 'intent' | 'completed' | 'cancelled' | 'failed'
  status       String
  shareCode    String    @unique
  clickedCount Int       @default(0)
  lastClickAt  DateTime?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Restrict)

  @@index([itineraryId])
  @@index([travelerId])
  @@index([creatorId])
  @@index([createdAt])
  @@map("itinerary_shares")
}

model ItineraryImage {
  id          String   @id @default(cuid())
  itineraryId String
  url         String
  alt         String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@map("itinerary_images")
}

model ItineraryFile {
  id          String   @id @default(cuid())
  itineraryId String
  name        String
  type        String // 'pdf' | 'spreadsheet' | 'document'
  url         String
  size        Int // bytes
  createdAt   DateTime @default(now())

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@map("itinerary_files")
}

model ItineraryDay {
  id          String   @id @default(cuid())
  itineraryId String
  dayNumber   Int
  title       String
  summary     String?  @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now())

  itinerary  Itinerary           @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  activities ItineraryActivity[]

  @@map("itinerary_days")
}

model ItineraryActivity {
  id          String   @id @default(cuid())
  dayId       String
  order       Int      @default(0)
  title       String
  description String?  @db.Text
  duration    String?
  location    String?
  tips        String?  @db.Text
  time        String?
  type        String? // 'transport' | 'activity' | 'meal' | 'rest'
  icon        String?
  images      String[]
  mapLink     String?
  latitude    Float?
  longitude   Float?
  category    String? // 'atração' | 'restaurante' | 'hotel'
  completed   Boolean  @default(false)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  day ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@map("itinerary_activities")
}

model ItineraryAccommodation {
  id            String   @id @default(cuid())
  itineraryId   String
  name          String
  neighborhood  String?
  description   String?  @db.Text
  priceRange    String?
  rating        Float?
  externalLink  String?
  // ─── Campos extras do editor ───
  address       String?
  mapLink       String?
  tips          String?  @db.Text
  nights        Int?
  startDate     String? // ISO date string
  endDate       String?
  totalPrice    String? // preço total da estadia
  priceCurrency String?
  // ─── Transparência graduada de custos (opt-in) ───
  // `spending`: { value, currency } — formato legado de gasto por pessoa
  // `cost`: ModuleCostInfo { amount, currency, disclosureType, notes, proofFiles, proofStatus, updatedAt }
  // Ambos opcionais; null para roteiros antigos.
  spending      Json?
  cost          Json?
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@map("itinerary_accommodations")
}

model ItineraryTransport {
  id             String   @id @default(cuid())
  itineraryId    String
  description    String?  @db.Text
  passTypes      String?
  estimatedPrice String?
  notes          String?  @db.Text
  // ─── Campos extras do editor ───
  startDate      String?
  endDate        String?
  priceValue     String?
  priceCurrency  String?
  // ─── Transparência graduada de custos (opt-in) ───
  spending       Json?
  cost           Json?
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@map("itinerary_transports")
}

model ItineraryChecklist {
  id          String   @id @default(cuid())
  itineraryId String
  category    String // 'documentos' | 'mala' | 'pre-viagem' | 'custom'
  item        String
  isDefault   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@map("itinerary_checklists")
}

model ItinerarySale {
  id           String   @id @default(cuid())
  itineraryId  String
  travelerId   String
  price        Float
  commission   Float
  // Rich purchase data for the purchased itinerary experience
  // NOTE: `purchaseData.routeSnapshot` (snapshotVersion: 1) é o snapshot
  // canônico da venda — congelado no momento da compra via
  // `buildPurchasedItineraryPayload(...)`. Reusamos esse campo para a
  // feature de Roteiro Editável Pós-Compra (Original vs. Minha versão);
  // não há `purchasedSnapshot` separado.
  purchaseData Json? // { routeSnapshot, checklist, weather, accommodation, emergencyContacts, spendingProfile, transport, flightInfo, accommodationOptions, receiveList }
  createdAt    DateTime @default(now())

  itinerary      Itinerary                        @relation(fields: [itineraryId], references: [id], onDelete: Restrict)
  traveler       Traveler                         @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  customizations TravelerItineraryCustomization[]
  checklistItems TravelerChecklistItem[]
  travelerFiles  TravelerFile[]

  @@map("itinerary_sales")
}

// ─────────────────────────────────────────────
// TRAVELER ITINERARY CUSTOMIZATION
// ─────────────────────────────────────────────
//
// Armazena as personalizações que um viajante faz sobre seu roteiro
// COMPRADO — sem nunca tocar no roteiro original do criador. Cada
// registro é a "camada de overlay" privada do viajante por roteiro:
//  - `addedItems`: novos itens criados pelo viajante, agrupados por kind
//     (accommodations, transports, attractions, restaurants, generalTips,
//     checklistItems, extraSpendingItems, flightOutbound, flightReturn,
//     dayActivities).
//  - `hiddenOriginalIds`: tokens `originalId` (do snapshot) que o
//     viajante escolheu ocultar — não apaga do snapshot, apenas marca.
//  - `editedOriginalItems`: mapa { [originalId]: Partial<data> } com
//     patches sobre itens originais. Campo com valor `null` significa
//     "remover esse campo" no merge.
//  - `notes`: anotações livres do viajante para essa viagem.
//
// O merge "snapshot + customization → roteiro personalizado" acontece
// inteiramente no mobile (`mergeItineraryWithCustomization`). O backend
// só armazena/valida o shape.
model TravelerItineraryCustomization {
  id                  String   @id @default(cuid())
  travelerId          String
  itineraryId         String
  saleId              String?
  notes               String?  @db.Text
  addedItems          Json     @default("[]")
  hiddenOriginalIds   Json     @default("[]")
  editedOriginalItems Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  traveler  Traveler       @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  itinerary Itinerary      @relation(fields: [itineraryId], references: [id], onDelete: Restrict)
  sale      ItinerarySale? @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([travelerId, itineraryId])
  @@index([saleId])
  @@map("traveler_itinerary_customizations")
}

// ─────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────

model Review {
  id           String   @id @default(cuid())
  travelerId   String
  packageId    String?
  itineraryId  String?
  rating       Float
  comment      String   @db.Text
  verified     Boolean  @default(false)
  language     String?
  // Denormalized user info for fast display
  userName     String?
  userLocation String?
  userAvatar   String?
  userInitial  String?
  helpful      Int      @default(0)
  createdAt    DateTime @default(now())

  traveler  Traveler         @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  package   Package?         @relation(fields: [packageId], references: [id], onDelete: Cascade)
  itinerary Itinerary?       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  images    ReviewImage[]
  responses ReviewResponse[]

  @@map("reviews")
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_images")
}

model ReviewResponse {
  id        String   @id @default(cuid())
  reviewId  String
  agencyId  String?
  creatorId String?
  text      String   @db.Text
  createdAt DateTime @default(now())

  review  Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  agency  Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  creator Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  @@map("review_responses")
}

// ─────────────────────────────────────────────
// PURCHASE HISTORY (Booking)
// ─────────────────────────────────────────────

model PurchaseHistory {
  id              String         @id @default(cuid())
  travelerId      String
  packageId       String
  pricingWindowId String?
  departureId     String? // link to specific departure
  totalPrice      Float
  travelers       Int            @default(1)
  status          PurchaseStatus @default(PENDING)
  // New booking detail fields
  bookingCode     String?        @unique
  paymentMethod   String?
  contactName     String?
  contactEmail    String?
  adultsCount     Int            @default(1)
  childrenCount   Int            @default(0)
  travelDate      DateTime?
  travelEndDate   DateTime?
  preparation     Json? // preparation tips grouped by category
  // Flight quote fields
  originCity      String?
  // Post-purchase documents (filled by agency per sale)
  voucherUrl      String?
  eticketUrl      String?
  autoMessage     String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  traveler          Traveler                @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  package           Package                 @relation(fields: [packageId], references: [id], onDelete: Cascade)
  pricingWindow     PackagePricingWindow?   @relation(fields: [pricingWindowId], references: [id], onDelete: SetNull)
  departure         PackageDeparture?       @relation("DepartureBookings", fields: [departureId], references: [id], onDelete: SetNull)
  timeline          BookingTimeline[]
  documents         BookingDocument[]
  bookingInclusions BookingInclusion[]
  flightQuote       FlightQuote?
  agencyDocuments   AgencyDocument[]
  checklistItems    TravelerChecklistItem[]
  files             TravelerFile[]

  @@map("purchase_history")
}

model BookingTimeline {
  id            String                @id @default(cuid())
  purchaseId    String
  title         String
  description   String
  status        BookingTimelineStatus @default(PENDING)
  icon          String
  completedDate DateTime?
  order         Int                   @default(0)
  createdAt     DateTime              @default(now())

  purchase PurchaseHistory @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("booking_timelines")
}

model BookingDocument {
  id          String              @id @default(cuid())
  purchaseId  String
  title       String
  description String
  icon        String
  type        BookingDocumentType
  available   Boolean             @default(false)
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())

  purchase PurchaseHistory @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("booking_documents")
}

model BookingInclusion {
  id         String   @id @default(cuid())
  purchaseId String
  icon       String
  label      String
  detail     String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  purchase PurchaseHistory @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("booking_inclusions")
}

// ─────────────────────────────────────────────
// FLIGHT QUOTES
// ─────────────────────────────────────────────

model FlightQuote {
  id             String      @id @default(cuid())
  purchaseId     String      @unique
  // Dados do pedido do usuário
  originCity     String
  originAirport  String?
  // Dados preenchidos pela agência
  airline        String?
  flightDetails  String?     @db.Text
  flightImageUrl String?
  airfarePrice   Float?
  totalPrice     Float?
  // Controle
  status         QuoteStatus @default(AWAITING_QUOTE)
  expiresAt      DateTime?
  quotedAt       DateTime?
  acceptedAt     DateTime?
  agencyNote     String?     @db.Text
  userNote       String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  purchase PurchaseHistory @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("flight_quotes")
}

// ─────────────────────────────────────────────
// AGENCY DOCUMENTS (sent by agency to traveler)
// ─────────────────────────────────────────────

model AgencyDocument {
  id          String        @id @default(cuid())
  purchaseId  String
  title       String
  description String?       @db.Text
  type        AgencyDocType
  fileUrl     String
  fileName    String?
  sentAt      DateTime      @default(now())
  viewedAt    DateTime?

  purchase PurchaseHistory @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("agency_documents")
}

// ─────────────────────────────────────────────
// SAVED ITEMS / PRICE ALERTS
// ─────────────────────────────────────────────

model SavedItem {
  id          String   @id @default(cuid())
  travelerId  String
  packageId   String?
  itineraryId String?
  priceAlert  Boolean  @default(false)
  createdAt   DateTime @default(now())

  traveler  Traveler   @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  package   Package?   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  itinerary Itinerary? @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@unique([travelerId, packageId])
  @@unique([travelerId, itineraryId])
  @@map("saved_items")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id         String           @id @default(cuid())
  travelerId String
  type       NotificationType
  title      String
  body       String           @db.Text
  read       Boolean          @default(false)
  data       Json?
  createdAt  DateTime         @default(now())

  traveler Traveler @relation(fields: [travelerId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─────────────────────────────────────────────
// FAQ
// ─────────────────────────────────────────────

model FaqQuestion {
  id          String   @id @default(cuid())
  travelerId  String
  packageId   String?
  itineraryId String?
  question    String   @db.Text
  createdAt   DateTime @default(now())

  traveler  Traveler    @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  package   Package?    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  itinerary Itinerary?  @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  answers   FaqAnswer[]

  @@map("faq_questions")
}

model FaqAnswer {
  id               String   @id @default(cuid())
  questionId       String
  agencyEmployeeId String?
  creatorId        String?
  answer           String   @db.Text
  createdAt        DateTime @default(now())

  question       FaqQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  agencyEmployee AgencyEmployee? @relation(fields: [agencyEmployeeId], references: [id], onDelete: SetNull)

  @@map("faq_answers")
}

// ─────────────────────────────────────────────
// DESTINATION (for search/suggestions)
// ─────────────────────────────────────────────

model Destination {
  id        String   @id @default(cuid())
  name      String
  country   String
  emoji     String
  popular   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([name, country])
  @@map("destinations")
}

// ─────────────────────────────────────────────
// AUDIT LOG (LGPD compliance — track all actions)
// ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  action    String // 'CREATE' | 'UPDATE' | 'DELETE'
  target    String // 'packages/pkg-id', 'itineraries/itin-id', 'creators/creator-id'
  who       String // agencyId, employeeId, travelerId, or adminId
  timestamp DateTime @default(now()) @db.Timestamp()
  ip        String?
  changes   Json? // { before: {...}, after: {...} } for UPDATE; {} for CREATE/DELETE
  createdAt DateTime @default(now())

  @@index([who])
  @@index([target])
  @@index([timestamp])
  @@index([action])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// TRAVELER TRIP CENTER (Minha Central da Viagem)
// ─────────────────────────────────────────────
// Itens de checklist e arquivos pessoais do viajante para uma viagem
// específica (roteiro comprado). Diferente do `ItineraryChecklist`, que
// pertence ao criador e vale para todo mundo que comprar, estes registros
// são privados do viajante e não vazam de volta para o criador.

model TravelerChecklistItem {
  id          String   @id @default(cuid())
  travelerId  String
  itineraryId String
  purchaseId  String?
  saleId      String?
  category    String // 'documentos' | 'mala' | 'pre-viagem' | 'finanças' | 'apps úteis' | 'outros' | 'custom'
  item        String
  completed   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  traveler  Traveler         @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  itinerary Itinerary        @relation(fields: [itineraryId], references: [id], onDelete: Restrict)
  purchase  PurchaseHistory? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  sale      ItinerarySale?   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([travelerId, itineraryId])
  @@index([purchaseId])
  @@index([saleId])
  @@map("traveler_checklist_items")
}

model TravelerFile {
  id               String   @id @default(cuid())
  travelerId       String
  itineraryId      String
  purchaseId       String?
  saleId           String?
  category         String // 'voos' | 'hospedagem' | 'passeios' | 'documentos' | 'seguro' | 'recibos' | 'transporte' | 'outros'
  title            String
  url              String
  originalFileName String?
  mimeType         String?
  sizeBytes        Int?
  note             String?  @db.Text
  content          Bytes?
  createdAt        DateTime @default(now())

  traveler  Traveler         @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  itinerary Itinerary        @relation(fields: [itineraryId], references: [id], onDelete: Restrict)
  purchase  PurchaseHistory? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  sale      ItinerarySale?   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([travelerId, itineraryId])
  @@index([purchaseId])
  @@index([saleId])
  @@map("traveler_files")
}
