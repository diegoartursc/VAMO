# Database
DATABASE_URL="postgresql://user:password@localhost:5432/vamo?schema=public"

# JWT — obrigatório, mínimo 32 caracteres, um valor DIFERENTE por ambiente.
# Gere com: openssl rand -base64 48
# Nunca copie um valor de exemplo: o servidor recusa subir com segredos conhecidos.
JWT_SECRET=""
# Token de acesso: 24h em dev (wizard de criação de roteiro pode levar >15min).
# Em produção, considere um valor mais curto + refresh frequente.
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"
# Autoriza POST /api/admin/seed (criar o primeiro admin) em QUALQUER ambiente.
# Vazio = rota fechada.
ADMIN_SEED_SECRET=""
# Só para testes automatizados (NODE_ENV=test). Em qualquer outro ambiente o
# servidor recusa subir com "true".
ALLOW_DEMO_PURCHASES="false"
# Stripe: o webhook exige assinatura em todos os ambientes. Em dev, use
# `stripe listen --forward-to localhost:3333/api/payments/webhook` e copie o whsec_.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Server
PORT=3000
NODE_ENV="development"

# Upload — Supabase Storage (bucket público "vamo-uploads")
# Com as duas vars abaixo definidas, os uploads vão para o Supabase Storage
# (obrigatório em produção: o disco do Render é efêmero). Sem elas, os
# arquivos caem no disco local (public/uploads) — ok apenas em dev.
# Onde obter: Supabase Dashboard → Project Settings → API
#   SUPABASE_URL = "Project URL" (ex.: https://xxxx.supabase.co)
#   SUPABASE_SERVICE_ROLE_KEY = key "service_role" (secreta! só no backend, nunca no client)
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Upload (Cloudinary — LEGADO, chaves mortas retornando 404; não usar)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# CORS de produção, separado por vírgulas.
ALLOWED_ORIGINS=""
