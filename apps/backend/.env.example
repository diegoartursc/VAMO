# Database
DATABASE_URL="postgresql://user:password@localhost:5432/vamo?schema=public"

# JWT — MUST SET IN PRODUCTION
# Generate a new secret: openssl rand -base64 32
# For development, use: bXTbleAdvChOal97Un3x1MGO4YYX1FZtLohF7QOIApw=
# For production, NEVER use the development secret above — generate a NEW one!
JWT_SECRET="CHANGE_ME_TO_SECURE_SECRET_VIA_ENV_VARS"
# Token de acesso: 24h em dev (wizard de criação de roteiro pode levar >15min).
# Em produção, considere um valor mais curto + refresh frequente.
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"
# Necessário apenas para autorizar POST /api/admin/seed em produção.
ADMIN_SEED_SECRET=""
# Temporário: libera o registro de compras sem gateway real.
# Mantenha false em produção até integrar e validar um provedor de pagamento.
ALLOW_DEMO_PURCHASES="false"

# Server
PORT=3000
NODE_ENV="development"

# Upload — Supabase Storage (bucket público "vamo-uploads")
# Com as duas vars abaixo definidas, os uploads vão para o Supabase Storage
# (obrigatório em produção: o disco do Render é efêmero). Sem elas, os
# arquivos caem no disco local (public/uploads) — ok apenas em dev.
# Onde obter: Supabase Dashboard → Project Settings → API
#   SUPABASE_URL = "Project URL" (ex.: https://xxxx.supabase.co)
#   SUPABASE_SERVICE_ROLE_KEY = key "service_role" (secreta! só no backend, nunca no client)
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Upload (Cloudinary — LEGADO, chaves mortas retornando 404; não usar)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# CORS de produção, separado por vírgulas.
ALLOWED_ORIGINS=""
