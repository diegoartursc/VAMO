{
  "expo": {
    "name": "VAMO",
    "slug": "vamo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3263"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vamo.app"
    },
    "android": {
      "package": "app.vamo.travel",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "backgroundColor": "#1A3263"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "VAMO uses your photos so you can add pictures to your itineraries and profile.",
          "cameraPermission": "VAMO uses your camera so you can take pictures for your itineraries and profile.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "vamo"
  }
}
